#!/usr/bin/env python3
"""Combine reviewed app vocabulary manifests for explicit operator publication.

This command reads source definitions. It never opens a LastDB home or contacts
Schema Service. Publish the output with the schema-service canonical-vocabulary
command and the dedicated LastSecrets publisher locator.
"""
import argparse
import hashlib
import json
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', action='append', type=Path, required=True,
                        help='Reviewed app canonical-fields.json; repeat per app')
    parser.add_argument('--output', type=Path, required=True,
                        help='Output outside Git for operator publication')
    args = parser.parse_args()
    fields = {}
    for source in args.source:
        manifest = json.loads(source.read_text())
        if manifest.get('policy_version', 1) != 1 or not isinstance(manifest.get('fields'), dict):
            parser.error(f'Invalid vocabulary manifest: {source}')
        for aliases in manifest.get('schemas', {}).values():
            if not isinstance(aliases, dict) or any(name not in manifest['fields'] for name in aliases.values()):
                parser.error(f'Schema refers to an undefined concept: {source}')
        for name, definition in manifest['fields'].items():
            if not isinstance(definition, dict) or not definition.get('description') or 'field_type' not in definition or definition.get('version', 0) < 1:
                parser.error(f'Incomplete concept: {source}: {name}')
            if name in fields and fields[name] != definition:
                parser.error(f'Conflicting definitions for {name}; resolve before publication')
            fields[name] = definition
    if not 1 <= len(fields) <= 512:
        parser.error('A publication batch requires 1..512 approved concepts')
    encoded = (json.dumps(fields, indent=2, sort_keys=True) + '\n').encode()
    with args.output.open('xb') as output:
        output.write(encoded)
    print(json.dumps({'source_manifests': len(args.source), 'concepts': len(fields),
                      'sha256': hashlib.sha256(encoded).hexdigest(), 'output': str(args.output)}))


if __name__ == '__main__':
    main()
